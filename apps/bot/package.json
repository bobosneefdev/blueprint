{
  "name": "@blueprint/bot",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "dev": "bun src/main.ts",
    "build": "bun build --compile --target=bun-windows-x64 src/main.ts --outfile dist/blueprint-bot.exe"
  },
  "dependencies": {
    "@blueprint/core": "workspace:*",
    "@blueprint/dsl": "workspace:*",
    "@blueprint/portal": "workspace:*",
    "effect": "4.0.2"
  }
}
