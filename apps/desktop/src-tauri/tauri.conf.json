{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "better-rust",
  "version": "0.1.0",
  "identifier": "dev.betterrust.app",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/better-rust-bot"],
    "resources": { "../../portal/build/": "portal/" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bobosneefdev/better-rust/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBLIC_KEY",
      "windows": { "installMode": "passive" }
    }
  }
}
