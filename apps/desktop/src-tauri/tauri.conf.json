{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blueprint",
  "version": "0.1.0",
  "identifier": "dev.bobosneef.blueprint",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/blueprint-bot"],
    "resources": {
      "../../portal/build/": "portal/",
      "mingit/": "mingit/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bobosneefdev/blueprint/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwREFGOEI4QzczRTgxRjEKUldUeGdUN0h1UGphVUduU2pXRFlhQ0RkM1EzMURuTFFqUkluVkt2RXdKemRacXpmZTkyU0ZLdnYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
